# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/mudar

# ── Auth (better-auth) ─────────────────────────────────────────────────────────
# URL donde corre la app web
BETTER_AUTH_URL=http://localhost:3001
# Secreto largo y aleatorio (ej: openssl rand -hex 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Orígenes adicionales permitidos (separados por coma), opcional
# BETTER_AUTH_TRUSTED_ORIGINS=https://tudominio.com

# ── Geo (TravelTime API) ───────────────────────────────────────────────────────
# Obtener en https://docs.traveltime.com/api/overview/introduction
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=

# ── Rebill (Pagos) ─────────────────────────────────────────────────────────────
# Obtener en https://app.rebill.com → Configuración → API Keys
REBILL_SECRET_KEY=sk_...
# Secreto para validar firma de webhooks (configurar en Rebill Dashboard → Developer Center → Webhooks)
REBILL_WEBHOOK_SECRET=
# URL pública de la app (para redirect_url tras el pago)
APP_URL=http://localhost:3001
