{
  "name": "@mudar/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth-schema": "./src/auth-schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "push": "pnpm with-env drizzle-kit push",
    "studio": "pnpm with-env drizzle-kit studio",
    "generate": "pnpm --filter @mudar/auth exec better-auth generate --config src/index.ts --output ../db/src/auth-schema.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@mudar/typescript-config": "workspace:*",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.8.2"
  }
}
